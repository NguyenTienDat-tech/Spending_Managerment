<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transactionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".ui.home_user.transaction.TransactionFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dateHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/date_header_height"
        android:background="@color/primary"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/previousDateBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/previous_date"
            android:padding="12dp"
            android:rotation="180"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_chevron"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/currentDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="26sp"
            android:text="@string/preview_date"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold|italic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/previousDateBtn"
            app:layout_constraintEnd_toStartOf="@id/nextDateBtn"
            tools:text="22/10/2026" />

        <ImageView
            android:id="@+id/nextDateBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/next_date"
            android:padding="12dp"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_chevron"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/dateHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabMinWidth="0dp"
        app:tabPaddingStart="0dp"
        app:tabPaddingEnd="0dp"
        app:tabIndicatorHeight="0dp"
        app:tabSelectedTextColor="@color/white"
        app:tabTextAppearance="@style/CustomTabTextAppearance"
        app:tabTextColor="@color/white">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_daily" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_monthly" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_calendar" />
    </com.google.android.material.tabs.TabLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/transactionSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/screen_background"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/incomeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_income"
            android:textColor="@color/greenColor"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/expenseTitle" />

        <TextView
            android:id="@+id/incomeLbl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="22sp"
            android:text="@string/zero_balance"
            android:textColor="@color/greenColor"
            android:textSize="22sp"
            app:layout_constraintTop_toBottomOf="@id/incomeTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintStart_toStartOf="@id/incomeTitle"
            app:layout_constraintEnd_toEndOf="@id/incomeTitle"
            tools:text="0 ₫" />

        <TextView
            android:id="@+id/expenseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_expense"
            android:textColor="@color/redColor"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/incomeTitle"
            app:layout_constraintEnd_toStartOf="@id/totalTitle" />

        <TextView
            android:id="@+id/expenseLbl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="22sp"
            android:text="@string/zero_balance"
            android:textColor="@color/redColor"
            android:textSize="22sp"
            app:layout_constraintTop_toBottomOf="@id/expenseTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintStart_toStartOf="@id/expenseTitle"
            app:layout_constraintEnd_toEndOf="@id/expenseTitle"
            tools:text="0 ₫" />

        <TextView
            android:id="@+id/totalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_total"
            android:textColor="@color/totalColor"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/expenseTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/totalLbl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="22sp"
            android:text="@string/zero_balance"
            android:textColor="@color/totalColor"
            android:textSize="22sp"
            app:layout_constraintTop_toBottomOf="@id/totalTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintStart_toStartOf="@id/totalTitle"
            app:layout_constraintEnd_toEndOf="@id/totalTitle"
            tools:text="0 ₫" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/transactionSummary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/empty_transactions"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/transactionList"
        app:layout_constraintBottom_toBottomOf="@id/transactionList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/add_transaction"
        app:tint="@color/white"
        app:backgroundTint="@color/add_button_background"
        app:fabCustomSize="56dp"
        app:maxImageSize="26dp"
        app:srcCompat="@drawable/ic_plus"
        app:shapeAppearanceOverlay="@style/RoundedFAB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
