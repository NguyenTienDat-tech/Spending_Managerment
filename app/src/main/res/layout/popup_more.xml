<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="196dp"
    android:layout_height="wrap_content"
    android:background="@drawable/more_menu_background"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/exportExcel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/app_export_excel"
        android:textColor="@color/text_primary"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/importExcel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/app_import_excel"
        android:textColor="@color/text_primary"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/clearData"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/app_clear_data"
        android:textColor="@color/text_primary"
        android:textSize="19sp" />
</LinearLayout>
