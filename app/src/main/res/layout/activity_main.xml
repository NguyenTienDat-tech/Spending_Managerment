<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    tools:context=".ui.home_user.activitymain.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/screen_toolbar_height"
        android:minHeight="@dimen/screen_toolbar_height"
        android:background="@color/primary"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/SpendingToolbarTitle"
        app:titleMarginStart="16dp"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp"
        app:title="@string/app_transaction"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHomeFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/screen_background"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_home_user"
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:minHeight="0dp"
        android:background="@color/primary"
        app:elevation="0dp"
        app:itemIconSize="@dimen/bottom_nav_icon_size"
        app:itemPaddingTop="12dp"
        app:itemPaddingBottom="12dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemTextAppearanceActive="@style/SpendingNavigationLabel.Active"
        app:itemTextAppearanceInactive="@style/SpendingNavigationLabel"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:itemActiveIndicatorStyle="@style/SpendingNavigationIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_home_user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
